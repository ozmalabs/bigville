+        senders = [people[node] for node in world.eng.neighbours(request, "from") if node in people]
+        out.append({"handle": str(attrs.get("name", "")), "who": senders[0] if senders else "",
+                    "what": str(attrs.get("task", ""))})
+    return out
+
