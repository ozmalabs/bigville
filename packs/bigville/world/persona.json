    "PERSONA_ENGINE_PARAMS": {
      "w_supergraph": "Ocelot's supergraph weight: how much the resident's cognition weights the shared graph. Engine configuration, read by the Ocelot cognition, not a word a resident would use.",
      "cred_on": "Ocelot's credence-update gain. Engine configuration.",
      "claim_weight": "Ocelot's claim weight, read by the cognition engine. Engine configuration.",
      "carried_weight": "The carrying weight of the resident's body model (world attribute). Engine configuration, not a personality word.",
      "resolution_bins": "Ocelot's causal-resolution bin count (FOUNDING_CAUSAL_RESOLUTION). Engine configuration.",
      "emotional_core_enabled": "Ocelot's emotional-core switch, set by the founding cast. Engine configuration."
    },
    "ROUTINE_BANDS": {
      "_doc": "The four hour bands the simple backend uses (bigville/backends/cheap.py, _time_band): morning before morning_until, workday to workday_until, evening to evening_until, night after. Each value is the boundary the simple backend had before Phase 058 (APPROX as a model choice, not sourced). Every ROUTINE row starts its work block at morning_until, its evening at workday_until and its sleep at evening_until, so the routine agrees with the bands.",
      "morning_until": 9.0,
      "workday_until": 17.0,
      "evening_until": 21.0
    },
    "ROUTINE": {
