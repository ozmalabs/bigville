    "ROUTINE_WEEK": {
      "_doc": "The weekly rhythm (APPROX, a model of the Bigville week). weekday = the calendar day modulo days_per_week (TIME). market: on market day, a job whose JOB_ROUTINE lists the market has its afternoon at the market. church: on church day the work block becomes the midday block at the church.",
      "market_day": 5,
      "church_day": 6,
      "market": {
        "block": "afternoon",
        "place": "market",
        "task": "selling and buying at the market"
      },
      "church": {
        "block": "work",
        "set": {
          "block": "midday",
          "place": "church",
          "task": "at the morning service, then at rest"
        }
      }
    },
