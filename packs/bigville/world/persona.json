    "RELATIONSHIP_SEEDING": {
      "_doc": "Founding ties (Phase 058). A tie is a held relationship record, directed, with a kind, a strength (the lexicon relationship_strength scale, 0 to 10; a feud is negative, as RELATIONSHIP_KINDS has rival_of at -0.8) and a one-line history. Structural ties are all written: spouses, kin from the held genealogical terms, and household members. Social ties are drawn per resident from the same-workplace, nearest-neighbour, friend and rival pools, with a generator seeded from the world seed plus 'stream' (distinct from KINSHIP_STREAM and the history stream). A rival is drawn for a resident whose spite is at or above rival_spite_min, and is the most distant candidate in class and trait. close_kinds are the ties that count towards max_close_ties; the others are acquaintances. Counts and strengths are APPROX within Dunbar's layers (Dunbar 1993, the sympathy group of about 15; Hill and Dunbar 2003). The stream and the thresholds are model choices. enabled switches the seeding. The bigville default is true: the founding town holds its ties (845 directed records at seed 305000, Phase 058), and the tests that assumed a town with no ties now assert them (Phase fix_simple_village). The test_hamlet pack has no founding town and keeps it false. The stream and the thresholds are model choices.",
      "enabled": true,
      "stream": 9058,
      "max_close_ties": 12,
      "close_kinds": [
        "spouse",
        "blood_kin",
        "household",
        "friend",
        "feud"
      ],
      "close_kin_terms": [
        "parent",
        "child",
        "sibling",
        "half_sibling"
      ],
      "colleague_count": 2,
      "neighbour_radius": 6,
      "neighbour_count": 2,
      "friend_count": 2,
      "rival_spite_min": 0.3,
      "rival_count": 1,
      "strength": {
        "spouse": 5.0,
        "close_kin": 5.0,
        "kin": 3.0,
        "household": 2.0,
        "friend": 2.0,
        "workmate": 1.0,
        "neighbour": 0.6,
        "feud": -0.8
      },
      "kind_of": {
        "spouse": "spouse",
        "close_kin": "blood_kin",
        "kin": "blood_kin",
        "household": "household",
        "friend": "friend",
        "workmate": "workmate",
        "neighbour": "neighbour",
        "feud": "feud"
      },
      "history": {
        "spouse": "married to you",
        "kin": "your {term}, related by birth",
        "household": "shares your house",
        "friend": "a friend of long standing",
        "workmate": "works at the same place as you",
