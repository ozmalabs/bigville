    "KIN_OBLIGATIONS": {
      "care_dependants": {
        "description": "Feed, house, and raise a dependent child or ward when parents cannot.",
        "source": "APPROX: usual pre-industrial English expectation; model category."
      },
      "care_elders": {
        "description": "Shelter and support an aged relative who can no longer work.",
        "source": "APPROX: usual pre-industrial English expectation; model category."
      },
      "support_in_need": {
        "description": "Lend help, labour, or money to a kinsman in hardship.",
        "source": "APPROX: model category, from Laslett 1972 on kin support in pre-industrial households."
      },
      "inheritance_claim": {
        "description": "A claim on the estate of the deceased under the village custom.",
        "source": "Goody, Thirsk and Thompson 1976 (see the INHERITANCE_CUSTOM note)."
      },
      "hospitality": {
        "description": "Welcome and a meal at the household, on visits and feast days.",
        "source": "APPROX: model category."
      }
    },
