{
  "id": "bigville_church",
  "version": "1.0.0",
  "depends_on": [],
  "self_load_only": true,
  "description": "bigville R30 (block 319000): the CHURCH's PUBLIC congregation + PRIVATE counsel room. The church already exists as a funded institution (bigville_fisc_church, 257000: donation/tithe, Mary's stipend, charity, fc_counsel affect co-regulation); Mary the pastor is a main named character (cast100, role:pastor, role_identity 0.81). This rung adds what was missing: the church is NON-DENOMINATIONAL (open to all, attendance gated only by faith, never creed); a PUBLIC Service with an EMERGENT congregation (ch_decide is each resident's collapse over {go,stay}, 'go' iff piety*pastor_draw > worldly_pull -> congregation = Count(attendees), never hardcoded); and a PRIVATE counsel room where what a resident confides to Mary is CONFIDENTIAL -- ch_counsel_private eases their distress and Mary holds a ConfidentialDisclosure{private:1} that is NEVER made public (the-room-where-it-happened occlusion: the observer reads it, the town cannot). The public face (attendance, reportable in the paper) and the private face (the sealed counsel) are the two halves of the same institution.",
  "nodes": [],
  "edges": [],
  "productions": [],
  "concepts": [],
  "rules": [
    {
      "name": "ch_hold_service",
      "batch": false,
      "comment": "On Sunday the pastor holds a public service; its draw is her own pull. One open service at a time.",
      "match": [
        [
          "town",
          "has_church",
          "church"
        ],
        [
          "church",
          "staffed_by",
          "pastor"
        ]
      ],
      "where": {
        "type": "And",
        "items": [
          {
            "type": "Eq",
            "a": {
              "type": "Plus",
              "items": [
                {
                  "type": "Attr",
                  "node": {
                    "type": "Var",
                    "name": "town"
                  },
                  "key": "sunday"
                },
                {
                  "type": "Lit",
                  "value": 0.0
                }
              ]
            },
            "b": {
              "type": "Lit",
              "value": 1.0
            }
          },
          {
            "type": "Not",
            "arg": {
              "type": "Exists",
              "source": {
                "type": "Neighbours",
                "node": {
                  "type": "Var",
                  "name": "church"
                },
                "edge_type": "has_service"
              },
              "var_name": "s2",
              "predicate": {
                "type": "Eq",
                "a": {
                  "type": "Plus",
                  "items": [
                    {
                      "type": "Attr",
                      "node": {
                        "type": "Var",
                        "name": "s2"
                      },
                      "key": "open"
                    },
                    {
                      "type": "Lit",
                      "value": 0.0
                    }
                  ]
                },
                "b": {
                  "type": "Lit",
                  "value": 1.0
                }
              }
            }
          }
        ]
      },
      "effects": [
        [
          "add_node",
          "service",
          "Service",
          {
            "open": 1.0,
            "draw": {
              "__term__": {
                "type": "Plus",
                "items": [
                  {
                    "type": "Attr",
                    "node": {
                      "type": "Var",
                      "name": "pastor"
                    },
                    "key": "draw"
                  },
                  {
                    "type": "Lit",
                    "value": 0.0
                  }
                ]
              }
            }
          }
        ],
        [
          "add_edge",
          "church",
          "has_service",
          "service"
        ]
      ]
    },
    {
      "name": "ch_decide",
      "batch": false,
      "comment": "Each resident decides to attend by a collapse over {go,stay}: 'go' iff piety*draw > worldly_pull. Non-denominational -> no creed gate, faith only. Once per resident per service.",
      "match": [
        [
          "town",
          "has_resident",
          "r"
        ],
        [
          "town",
          "has_church",
          "church"
        ],
        [
          "church",
          "has_service",
          "service"
        ]
      ],
      "where": {
        "type": "And",
        "items": [
          {
            "type": "Eq",
            "a": {
              "type": "Plus",
              "items": [
                {
                  "type": "Attr",
                  "node": {
                    "type": "Var",
                    "name": "service"
                  },
                  "key": "open"
                },
                {
                  "type": "Lit",
                  "value": 0.0
                }
              ]
            },
            "b": {
              "type": "Lit",
              "value": 1.0
            }
          },
          {
            "type": "Not",
            "arg": {
              "type": "Exists",
              "source": {
                "type": "Neighbours",
                "node": {
                  "type": "Var",
                  "name": "r"
                },
                "edge_type": "weighed"
              },
              "var_name": "x",
              "predicate": {
                "type": "Eq",
                "a": {
                  "type": "Var",
                  "name": "x"
                },
                "b": {
                  "type": "Var",
                  "name": "service"
                }
              }
            }
          }
        ]
      },
      "effects": [
        [
          "set_attr",
          "r",
          "church_choice",
          {
            "__term__": {
              "type": "Attr",
              "node": {
                "type": "Argmax",
                "source": {
                  "type": "NodesOfType",
                  "node_type": "ChurchChoice"
                },
                "var_name": "c",
                "value": {
                  "type": "Times",
                  "items": [
                    {
                      "type": "Plus",
                      "items": [
                        {
                          "type": "Attr",
                          "node": {
                            "type": "Var",
                            "name": "c"
                          },
                          "key": "attend_sign"
                        },
                        {
                          "type": "Lit",
                          "value": 0.0
                        }
                      ]
                    },
                    {
                      "type": "Minus",
                      "a": {
                        "type": "Times",
                        "items": [
                          {
                            "type": "Plus",
                            "items": [
                              {
                                "type": "Attr",
                                "node": {
                                  "type": "Var",
                                  "name": "r"
                                },
                                "key": "piety"
                              },
                              {
                                "type": "Lit",
                                "value": 0.0
                              }
                            ]
                          },
                          {
                            "type": "Plus",
                            "items": [
                              {
                                "type": "Attr",
                                "node": {
                                  "type": "Var",
                                  "name": "service"
                                },
                                "key": "draw"
                              },
                              {
                                "type": "Lit",
                                "value": 0.0
                              }
                            ]
                          }
                        ]
                      },
                      "b": {
                        "type": "Plus",
                        "items": [
                          {
                            "type": "Attr",
                            "node": {
                              "type": "Var",
                              "name": "r"
                            },
                            "key": "worldly_pull"
                          },
                          {
                            "type": "Lit",
                            "value": 0.0
                          }
                        ]
                      }
                    }
                  ]
                }
              },
              "key": "label"
            }
          }
        ],
        [
          "add_edge",
          "r",
          "weighed",
          "service"
        ]
      ]
    },
    {
      "name": "ch_enter",
      "batch": false,
      "comment": "A resident whose collapse chose 'go' joins the public congregation (attends).",
      "match": [
        [
          "town",
          "has_resident",
          "r"
        ],
        [
          "town",
          "has_church",
          "church"
        ],
        [
          "church",
          "has_service",
          "service"
        ]
      ],
      "where": {
        "type": "And",
        "items": [
          {
            "type": "Eq",
            "a": {
              "type": "Attr",
              "node": {
                "type": "Var",
                "name": "r"
              },
              "key": "church_choice"
            },
            "b": {
