                },
                "edge_type": "attends"
              },
              "var_name": "y",
              "predicate": {
                "type": "Eq",
                "a": {
                  "type": "Var",
                  "name": "y"
                },
                "b": {
                  "type": "Var",
                  "name": "service"
                }
              }
            }
          }
        ]
      },
      "effects": [
        [
          "add_edge",
          "r",
          "attends",
          "service"
        ]
      ]
    },
    {
      "name": "ch_counsel_private",
      "batch": false,
      "comment": "In the PRIVATE room, Mary counsels a resident who came for it (counsel_armed): their distress is eased, and what they confided becomes a ConfidentialDisclosure Mary holds PRIVATELY (private:1) -- never made public. The-room-where-it-happened: the observer reads it, the town cannot.",
      "match": [
        [
          "town",
          "has_church",
          "church"
        ],
        [
          "church",
          "staffed_by",
          "mary"
        ],
        [
          "church",
          "has_room",
          "room"
        ],
        [
          "town",
          "has_resident",
          "r"
        ]
      ],
      "where": {
        "type": "And",
        "items": [
          {
            "type": "Eq",
            "a": {
              "type": "Plus",
              "items": [
