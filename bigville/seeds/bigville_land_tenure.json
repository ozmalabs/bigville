        {
         "type": "Attr",
         "node": {
          "type": "Var",
          "name": "plot"
         },
         "key": "tax_armed"
        },
        {
         "type": "Lit",
         "value": 0.0
        }
       ]
      },
      "b": {
       "type": "Lit",
       "value": 1.0
      }
     },
     {
      "type": "Gte",
      "a": {
       "type": "Plus",
       "items": [
        {
         "type": "Attr",
         "node": {
          "type": "Var",
          "name": "owner"
         },
         "key": "coin"
        },
        {
         "type": "Lit",
         "value": 0.0
        }
       ]
      },
      "b": {
       "type": "Plus",
       "items": [
        {
         "type": "Attr",
         "node": {
          "type": "Var",
          "name": "plot"
         },
         "key": "tax"
        },
        {
         "type": "Lit",
         "value": 0.0
        }
       ]
      }
     }
    ]
   },
   "effects": [
    [
     "set_attr",
     "owner",
     "coin",
     {
      "__term__": {
       "type": "Minus",
       "a": {
        "type": "Plus",
        "items": [
         {
          "type": "Attr",
          "node": {
           "type": "Var",
           "name": "owner"
          },
          "key": "coin"
         },
         {
          "type": "Lit",
          "value": 0.0
         }
        ]
       },
       "b": {
        "type": "Plus",
        "items": [
         {
          "type": "Attr",
          "node": {
           "type": "Var",
           "name": "plot"
          },
          "key": "tax"
         },
         {
          "type": "Lit",
          "value": 0.0
         }
        ]
       }
      }
     }
    ],
    [
     "set_attr",
     "council",
     "coin",
     {
      "__term__": {
       "type": "Plus",
       "items": [
        {
         "type": "Plus",
         "items": [
          {
           "type": "Attr",
           "node": {
            "type": "Var",
            "name": "council"
           },
           "key": "coin"
          },
          {
           "type": "Lit",
           "value": 0.0
          }
         ]
        },
        {
         "type": "Plus",
         "items": [
          {
           "type": "Attr",
           "node": {
            "type": "Var",
            "name": "plot"
           },
           "key": "tax"
          },
          {
           "type": "Lit",
           "value": 0.0
          }
         ]
        }
       ]
      }
     }
    ],
    [
     "set_attr",
     "plot",
     "tax_armed",
     0.0
    ]
   ]
  },
  {
   "name": "bl_tax_forfeit",
   "batch": false,
   "match": [
    [
     "owner",
     "owns",
     "plot"
    ],
    [
     "plot",
