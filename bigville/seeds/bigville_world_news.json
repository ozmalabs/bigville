          "type": "Attr",
          "node": {
           "type": "Var",
           "name": "news"
          },
          "key": "credibility"
         },
         {
          "type": "Lit",
          "value": 0.0
         }
        ]
       }
      },
      "about_place": {
       "__term__": {
        "type": "Plus",
        "items": [
         {
          "type": "Attr",
          "node": {
           "type": "Var",
           "name": "place"
          },
          "key": "place_id"
         },
         {
          "type": "Lit",
          "value": 0.0
         }
        ]
       }
      }
     }
    ],
    [
     "add_edge",
     "res",
     "giantville_belief",
     "blf"
    ],
    [
     "set_attr",
     "res",
     "comprehend_armed",
     0.0
    ]
   ]
  },
