{
  "id": "bigville_tool_wear",
  "version": "1.0.0",
  "depends_on": [],
  "self_load_only": true,
  "description": "bigville R64 (block 378000): TOOLS DEGRADE WITH USE. A Tool has a condition (1.0 = new) that drops by its wear rate each use; its effective Fitness scales with condition (mult = base * condition) -- a worn tool works less well. Worn to nothing it BREAKS (broken=1, fitness 0) and must be repaired or replaced. td_repair: a smith/woodworker restores it to full. Closes the loop: tools wear out -> repair or replace -> more work for the trades (and their apprentices). Composes with bigville_craft (the Fitness it degrades is the forged one) and bigville_tools.",
  "nodes": [],
  "edges": [],
  "productions": [],
  "concepts": [],
  "rules": [
    {
      "name": "td_use",
      "batch": false,
      "comment": "TOOLS DEGRADE WITH USE: each use drops the tool's condition by its wear rate (floored at 0), and its effective Fitness scales with condition -- mult = base * condition. A well-worn tool works less well; a fresh one at full. use_armed is a one-shot (consumed). (fit.mult is set BEFORE condition is decremented -- avoids the sequential-read lag.)",
      "match": [
        [
          "tool",
          "fit_for",
          "fit"
        ]
      ],
      "where": {
        "type": "Eq",
        "a": {
          "type": "Plus",
          "items": [
            {
              "type": "Attr",
              "node": {
                "type": "Var",
                "name": "tool"
              },
              "key": "use_armed"
            },
            {
              "type": "Lit",
              "value": 0.0
            }
          ]
        },
        "b": {
          "type": "Lit",
          "value": 1.0
        }
      },
      "effects": [
        [
          "set_attr",
          "fit",
          "mult",
          {
            "__term__": {
              "type": "Times",
              "items": [
                {
                  "type": "Plus",
                  "items": [
                    {
                      "type": "Attr",
                      "node": {
                        "type": "Var",
                        "name": "fit"
                      },
                      "key": "base"
                    },
                    {
                      "type": "Lit",
                      "value": 0.0
                    }
                  ]
                },
                {
                  "type": "Max",
                  "items": [
                    {
                      "type": "Lit",
                      "value": 0.0
                    },
                    {
                      "type": "Minus",
                      "a": {
                        "type": "Plus",
                        "items": [
                          {
                            "type": "Attr",
                            "node": {
                              "type": "Var",
                              "name": "tool"
                            },
                            "key": "condition"
                          },
                          {
                            "type": "Lit",
                            "value": 0.0
                          }
                        ]
                      },
                      "b": {
                        "type": "Plus",
                        "items": [
                          {
                            "type": "Attr",
                            "node": {
                              "type": "Var",
                              "name": "tool"
                            },
                            "key": "wear"
                          },
                          {
                            "type": "Lit",
                            "value": 0.0
                          }
                        ]
                      }
                    }
                  ]
                }
              ]
            }
          }
        ],
        [
          "set_attr",
          "tool",
          "condition",
          {
            "__term__": {
              "type": "Max",
              "items": [
                {
                  "type": "Lit",
                  "value": 0.0
                },
                {
                  "type": "Minus",
                  "a": {
                    "type": "Plus",
                    "items": [
                      {
                        "type": "Attr",
                        "node": {
                          "type": "Var",
                          "name": "tool"
                        },
                        "key": "condition"
                      },
                      {
                        "type": "Lit",
                        "value": 0.0
                      }
                    ]
                  },
                  "b": {
                    "type": "Plus",
                    "items": [
                      {
                        "type": "Attr",
                        "node": {
                          "type": "Var",
                          "name": "tool"
                        },
                        "key": "wear"
                      },
                      {
                        "type": "Lit",
                        "value": 0.0
                      }
                    ]
                  }
                }
              ]
            }
          }
        ],
        [
          "set_attr",
          "tool",
          "uses",
          {
            "__term__": {
              "type": "Plus",
              "items": [
                {
                  "type": "Plus",
                  "items": [
                    {
                      "type": "Attr",
                      "node": {
                        "type": "Var",
                        "name": "tool"
                      },
                      "key": "uses"
                    },
                    {
                      "type": "Lit",
                      "value": 0.0
                    }
                  ]
                },
                {
                  "type": "Lit",
                  "value": 1.0
                }
              ]
            }
          }
        ],
        [
          "set_attr",
          "tool",
          "use_armed",
          0.0
        ]
      ]
    },
    {
      "name": "td_break",
      "batch": false,
      "comment": "A tool worn to nothing BREAKS: condition ~0 -> broken=1 and its Fitness drops to 0 (unusable). It must be repaired or replaced -- more work for the smith/woodworker.",
      "match": [
        [
          "tool",
          "fit_for",
          "fit"
        ]
      ],
      "where": {
        "type": "And",
        "items": [
          {
            "type": "Lt",
            "a": {
              "type": "Plus",
              "items": [
                {
                  "type": "Attr",
                  "node": {
                    "type": "Var",
                    "name": "tool"
                  },
                  "key": "condition"
                },
                {
                  "type": "Lit",
                  "value": 0.0
                }
              ]
            },
            "b": {
              "type": "Lit",
              "value": 0.001
            }
          },
          {
            "type": "Not",
            "arg": {
              "type": "Eq",
              "a": {
                "type": "Plus",
                "items": [
                  {
                    "type": "Attr",
                    "node": {
                      "type": "Var",
                      "name": "tool"
                    },
                    "key": "broken"
                  },
                  {
                    "type": "Lit",
                    "value": 0.0
                  }
                ]
              },
              "b": {
                "type": "Lit",
                "value": 1.0
              }
            }
          }
        ]
      },
      "effects": [
        [
          "set_attr",
          "tool",
          "broken",
          1.0
        ],
        [
          "set_attr",
          "fit",
          "mult",
          0.0
        ]
      ]
    },
    {
      "name": "td_repair",
      "batch": false,
      "comment": "REPAIR: a smith/woodworker who repairs a tool (maker -repairs-> tool) restores it -- condition back to full, not broken, Fitness back to base. Closes wear -> repair -> more craft work.",
      "match": [
        [
          "maker",
          "repairs",
          "tool"
        ],
        [
          "tool",
          "fit_for",
          "fit"
        ]
      ],
      "where": {
        "type": "Eq",
        "a": {
          "type": "Plus",
          "items": [
            {
              "type": "Attr",
              "node": {
                "type": "Var",
                "name": "tool"
              },
              "key": "repair_armed"
            },
            {
              "type": "Lit",
              "value": 0.0
            }
          ]
        },
        "b": {
          "type": "Lit",
          "value": 1.0
        }
      },
      "effects": [
        [
          "set_attr",
          "tool",
          "condition",
          1.0
        ],
        [
          "set_attr",
          "tool",
          "broken",
          0.0
        ],
        [
          "set_attr",
          "fit",
          "mult",
          {
            "__term__": {
              "type": "Plus",
              "items": [
                {
                  "type": "Attr",
                  "node": {
                    "type": "Var",
                    "name": "fit"
                  },
                  "key": "base"
                },
                {
                  "type": "Lit",
                  "value": 0.0
                }
              ]
            }
          }
        ],
        [
          "set_attr",
          "tool",
          "repair_armed",
          0.0
        ],
        [
          "del_edge",
          "maker",
          "repairs",
          "tool"
        ]
      ]
    }
  ]
}