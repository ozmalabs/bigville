{
  "id": "bigville_actor_decision",
  "version": "1.3.0",
  "depends_on": [],
  "self_load_only": true,
  "description": "Graph-native resident action selection. The world publishes legal ActorOption affordances. Graph rules add appetite utility to eat/fetch choices from the resident current observed hunger, then graph Argmax selects the highest-scoring option. The graph returns a per-option discriminator so provider-only action parameters survive selection.",
  "nodes": [],
  "edges": [],
  "productions": [],
  "concepts": [],
  "rules": [
    {
      "name": "o0_score_hungry_eat",
      "batch": false,
      "comment": "Add the resident observed-hunger utility to one currently offered food affordance.",
      "match": [
        [
          "a",
          "has_option",
          "option"
        ]
      ],
      "where": {
        "type": "And",
        "items": [
          {
            "type": "Eq",
            "a": {
              "type": "Attr",
              "node": {
                "type": "Var",
                "name": "a"
              },
              "key": "decision_armed"
            },
            "b": {
              "type": "Lit",
              "value": 1.0
            }
          },
          {
            "type": "Eq",
            "a": {
              "type": "Attr",
              "node": {
                "type": "Var",
                "name": "option"
              },
              "key": "hunger_scored"
            },
            "b": {
              "type": "Lit",
              "value": 0.0
            }
          },
          {
            "type": "Gt",
            "a": {
              "type": "Attr",
              "node": {
                "type": "Var",
                "name": "option"
              },
              "key": "hunger_eat_weight"
            },
            "b": {
              "type": "Lit",
              "value": 0.0
            }
          }
        ]
      },
      "effects": [
        [
          "set_attr",
          "option",
          "score",
          {
            "__term__": {
              "type": "Plus",
              "items": [
                {
                  "type": "Attr",
                  "node": {
                    "type": "Var",
                    "name": "option"
                  },
                  "key": "score"
                },
                {
                  "type": "Times",
                  "items": [
                    {
                      "type": "Minus",
                      "a": {
                        "type": "Times",
                        "items": [
                          {
                            "type": "Lit",
                            "value": 100.0
                          },
                          {
                            "type": "Attr",
                            "node": {
                              "type": "Var",
                              "name": "a"
                            },
                            "key": "observed_hunger"
                          }
                        ]
                      },
                      "b": {
                        "type": "Lit",
                        "value": 1.0
                      }
                    },
                    {
                      "type": "Attr",
                      "node": {
                        "type": "Var",
                        "name": "option"
                      },
                      "key": "hunger_eat_weight"
                    }
                  ]
                }
              ]
            }
          }
        ],
        [
          "set_attr",
          "option",
          "hunger_scored",
          1.0
        ]
      ]
    },
    {
