{
 "id": "bigville_build_mutate",
 "version": "1.0.0",
 "depends_on": [],
 "self_load_only": true,
 "description": "BIGVILLE R12 (block 260000) -- the MUTABLE WORLD (the new capability). bbnav_wall_off SEVERS the walkable adjacency of any `blocked` map cell so the existing bigville_move_nav Bellman flood RE-ROUTES around a new building (the map-belief is graph data a rule mutated; nav re-queries it). bb_church_expand grows an Institution's capacity+size IFF its donations/funds suffice (a grounded lift of R9's fixed size; control = funds<cost -> no expansion). bb_demolish reverts a building (clears built/blocked/occludes, drops the Building) so the cells revert. Composes existing DSL Terms only; ZERO new Rust.",
 "nodes": [],
 "edges": [],
 "productions": [],
 "concepts": [],
 "rules": [
  {
   "name": "bbnav_wall_off",
   "batch": false,
   "match": [
    [
     "a",
     "adj",
     "b"
    ]
   ],
   "where": {
    "type": "Gte",
    "a": {
     "type": "Plus",
     "items": [
      {
       "type": "Plus",
       "items": [
        {
         "type": "Attr",
         "node": {
          "type": "Var",
          "name": "a"
         },
         "key": "blocked"
        },
        {
         "type": "Lit",
         "value": 0.0
        }
       ]
      },
      {
       "type": "Plus",
       "items": [
        {
         "type": "Attr",
         "node": {
          "type": "Var",
          "name": "b"
         },
         "key": "blocked"
        },
        {
         "type": "Lit",
         "value": 0.0
        }
       ]
      }
     ]
    },
    "b": {
     "type": "Lit",
     "value": 1.0
    }
   },
   "effects": [
    [
     "del_edge",
     "a",
     "adj",
     "b"
    ]
   ]
  },
  {
   "name": "bb_church_expand",
   "batch": false,
   "match": [
    [
     "inst",
     "occupies",
     "c"
    ]
   ],
   "where": {
    "type": "And",
    "items": [
     {
      "type": "Eq",
      "a": {
       "type": "Plus",
       "items": [
        {
         "type": "Attr",
         "node": {
          "type": "Var",
          "name": "inst"
         },
         "key": "expand_armed"
        },
        {
         "type": "Lit",
         "value": 0.0
        }
       ]
      },
      "b": {
       "type": "Lit",
       "value": 1.0
      }
     },
     {
      "type": "Gte",
      "a": {
       "type": "Plus",
       "items": [
        {
         "type": "Attr",
         "node": {
          "type": "Var",
          "name": "inst"
         },
         "key": "funds"
        },
        {
         "type": "Lit",
         "value": 0.0
        }
       ]
      },
      "b": {
       "type": "Plus",
       "items": [
        {
         "type": "Attr",
         "node": {
          "type": "Var",
          "name": "inst"
         },
         "key": "expand_cost"
        },
        {
         "type": "Lit",
         "value": 0.0
        }
       ]
      }
     }
    ]
   },
   "effects": [
    [
     "set_attr",
     "inst",
     "funds",
     {
      "__term__": {
       "type": "Minus",
       "a": {
        "type": "Plus",
        "items": [
         {
          "type": "Attr",
          "node": {
           "type": "Var",
           "name": "inst"
          },
          "key": "funds"
         },
         {
          "type": "Lit",
          "value": 0.0
         }
        ]
       },
       "b": {
        "type": "Plus",
        "items": [
         {
          "type": "Attr",
          "node": {
           "type": "Var",
           "name": "inst"
          },
          "key": "expand_cost"
         },
         {
          "type": "Lit",
          "value": 0.0
         }
        ]
       }
      }
     }
    ],
    [
     "set_attr",
     "inst",
     "capacity",
     {
      "__term__": {
       "type": "Plus",
       "items": [
        {
         "type": "Plus",
         "items": [
          {
           "type": "Attr",
           "node": {
            "type": "Var",
            "name": "inst"
           },
           "key": "capacity"
          },
          {
           "type": "Lit",
           "value": 0.0
          }
         ]
        },
        {
         "type": "Lit",
         "value": 1.0
        }
       ]
      }
     }
    ],
    [
     "set_attr",
     "inst",
     "size",
     {
      "__term__": {
       "type": "Plus",
       "items": [
        {
         "type": "Plus",
         "items": [
          {
           "type": "Attr",
           "node": {
            "type": "Var",
            "name": "inst"
           },
           "key": "size"
          },
          {
           "type": "Lit",
           "value": 0.0
          }
         ]
        },
        {
         "type": "Lit",
         "value": 1.0
        }
       ]
      }
     }
    ],
    [
     "set_attr",
     "inst",
     "expand_armed",
     0.0
    ]
   ]
  },
  {
   "name": "bb_demolish",
   "batch": false,
   "match": [
    [
     "plot",
     "has_building",
     "bldg"
    ],
    [
     "plot",
     "on_cell",
     "c"
    ]
   ],
   "where": {
    "type": "Eq",
    "a": {
     "type": "Plus",
     "items": [
      {
       "type": "Attr",
       "node": {
        "type": "Var",
        "name": "bldg"
       },
       "key": "demolish_armed"
      },
      {
       "type": "Lit",
       "value": 0.0
      }
     ]
    },
    "b": {
     "type": "Lit",
     "value": 1.0
    }
   },
   "effects": [
    [
     "set_attr",
     "plot",
     "built",
     0.0
    ],
    [
     "set_attr",
     "c",
     "blocked",
     0.0
    ],
    [
     "set_attr",
     "c",
     "occludes",
     0.0
    ],
    [
     "del_edge",
     "plot",
     "has_building",
     "bldg"
    ],
    [
     "del_node",
     "bldg"
    ]
   ]
  }
 ]
}
