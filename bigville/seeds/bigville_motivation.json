{
  "id": "bigville_motivation",
  "version": "1.0.0",
  "depends_on": [],
  "self_load_only": true,
  "description": "bigville R34 / cognitive C1 (block 325000): the MOTIVATIONAL CORE -- drives + Psi modulators (Dorner Psi / Bach MicroPsi + Self-Determination Theory). Each agent holds Drive{kind,level,setpoint,weight} nodes (a data-driven set: sustenance + competence/affiliation/certainty). mv_urge: urge = weight*max(0,setpoint-level) -- the deficit scaled by how much THIS agent cares. mv_arousal: arousal = the max urge; modulators derive from it -- resolution_level = max(0,1-res_gain*arousal) (high arousal -> shallow) and selection_threshold = thr_gain*arousal (high arousal -> persistence). The agent PURSUES the max-urge drive (an Argmax collapse over its OWN drives), switching goal only when a challenger out-urges the incumbent by more than the selection_threshold (hysteresis -- the modulator shaping cognition). Different weight profiles diverge on the same world; uniform profiles collapse the divergence.",
  "nodes": [],
  "edges": [],
  "productions": [],
  "concepts": [],
  "rules": [
    {
      "name": "mv_urge",
      "batch": false,
      "comment": "Each drive's urge = weight * max(0, setpoint - level): the deficit scaled by the agent's care.",
      "match": [
        [
          "a",
          "has_drive",
          "d"
        ]
      ],
      "where": {
        "type": "Lit",
        "value": true
      },
      "effects": [
        [
          "set_attr",
          "d",
          "urge",
          {
            "__term__": {
              "type": "Times",
              "items": [
                {
                  "type": "Plus",
                  "items": [
                    {
                      "type": "Attr",
                      "node": {
                        "type": "Var",
                        "name": "d"
                      },
                      "key": "weight"
                    },
                    {
                      "type": "Lit",
                      "value": 0.0
                    }
                  ]
                },
                {
                  "type": "Max",
                  "items": [
                    {
                      "type": "Lit",
                      "value": 0.0
                    },
                    {
                      "type": "Minus",
                      "a": {
                        "type": "Plus",
                        "items": [
                          {
                            "type": "Attr",
                            "node": {
                              "type": "Var",
                              "name": "d"
                            },
                            "key": "setpoint"
                          },
                          {
                            "type": "Lit",
                            "value": 0.0
                          }
                        ]
                      },
                      "b": {
                        "type": "Plus",
                        "items": [
                          {
                            "type": "Attr",
                            "node": {
                              "type": "Var",
                              "name": "d"
                            },
                            "key": "level"
                          },
                          {
                            "type": "Lit",
                            "value": 0.0
                          }
                        ]
                      }
                    }
                  ]
                }
              ]
            }
          }
        ]
      ]
    },
    {
      "name": "mv_arousal",
      "batch": false,
      "comment": "arousal = the dominant (max) urge; Psi modulators derive from it (resolution down, selection_threshold up).",
      "match": [
        [
          "town",
          "has_agent",
          "a"
        ]
      ],
      "where": {
        "type": "Lit",
        "value": true
      },
      "effects": [
        [
          "set_attr",
          "a",
          "arousal",
          {
            "__term__": {
              "type": "Attr",
              "node": {
                "type": "Argmax",
                "source": {
                  "type": "Neighbours",
                  "node": {
                    "type": "Var",
                    "name": "a"
                  },
                  "edge_type": "has_drive"
                },
                "var_name": "d",
                "value": {
                  "type": "Plus",
                  "items": [
                    {
                      "type": "Attr",
                      "node": {
                        "type": "Var",
                        "name": "d"
                      },
                      "key": "urge"
                    },
                    {
                      "type": "Lit",
                      "value": 0.0
                    }
                  ]
                }
              },
              "key": "urge"
            }
          }
        ],
        [
          "set_attr",
          "a",
          "resolution_level",
          {
            "__term__": {
              "type": "Max",
              "items": [
                {
                  "type": "Lit",
                  "value": 0.0
                },
                {
                  "type": "Minus",
                  "a": {
                    "type": "Lit",
                    "value": 1.0
                  },
                  "b": {
                    "type": "Times",
                    "items": [
                      {
                        "type": "Plus",
                        "items": [
                          {
                            "type": "Attr",
                            "node": {
                              "type": "Var",
                              "name": "a"
                            },
                            "key": "res_gain"
                          },
                          {
                            "type": "Lit",
                            "value": 0.0
                          }
                        ]
                      },
                      {
                        "type": "Attr",
                        "node": {
                          "type": "Argmax",
                          "source": {
                            "type": "Neighbours",
                            "node": {
                              "type": "Var",
                              "name": "a"
                            },
                            "edge_type": "has_drive"
                          },
                          "var_name": "d",
                          "value": {
                            "type": "Plus",
                            "items": [
                              {
                                "type": "Attr",
                                "node": {
                                  "type": "Var",
                                  "name": "d"
                                },
                                "key": "urge"
                              },
                              {
                                "type": "Lit",
                                "value": 0.0
                              }
                            ]
                          }
                        },
                        "key": "urge"
                      }
                    ]
                  }
                }
              ]
            }
          }
        ],
        [
          "set_attr",
          "a",
          "selection_threshold",
          {
            "__term__": {
              "type": "Times",
              "items": [
                {
                  "type": "Plus",
