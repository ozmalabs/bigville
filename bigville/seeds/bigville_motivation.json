                    {
                      "type": "Attr",
                      "node": {
                        "type": "Var",
                        "name": "a"
                      },
                      "key": "thr_gain"
                    },
                    {
                      "type": "Lit",
                      "value": 0.0
                    }
                  ]
                },
                {
                  "type": "Attr",
                  "node": {
                    "type": "Argmax",
                    "source": {
                      "type": "Neighbours",
                      "node": {
                        "type": "Var",
                        "name": "a"
                      },
                      "edge_type": "has_drive"
                    },
                    "var_name": "d",
                    "value": {
                      "type": "Plus",
                      "items": [
                        {
                          "type": "Attr",
                          "node": {
                            "type": "Var",
                            "name": "d"
                          },
                          "key": "urge"
                        },
                        {
                          "type": "Lit",
                          "value": 0.0
                        }
                      ]
                    }
                  },
                  "key": "urge"
                }
              ]
            }
          }
        ]
      ]
    },
