          "name": "m"
         },
         "key": "settle_check_armed"
        },
        {
         "type": "Lit",
         "value": 0.0
        }
       ]
      },
      "b": {
       "type": "Lit",
       "value": 1.0
      }
     },
     {
      "type": "Or",
      "items": [
       {
        "type": "Not",
