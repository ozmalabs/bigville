                {
                  "type": "Attr",
                  "node": {
                    "type": "Var",
                    "name": "effort"
                  },
                  "key": "cost_done"
                },
                {
                  "type": "Lit",
                  "value": 0.0
                }
              ]
            },
            "b": {
              "type": "Lit",
              "value": 0.0
