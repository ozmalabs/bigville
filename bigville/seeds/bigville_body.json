{
  "seed": "bigville_body",
  "version": "1.4.0",
  "comment": "The BODY layer -- World -> Body -> Mind. Physiology (health, mood, satiety, palate, STRENGTH + STAMINA with a short-term stamina RESERVE) on a Body node the Mind HAS. World events drive the body by rule; health modulates strength/stamina; USE builds them slowly toward a base-relative ceiling while exertion DEPLETES the reserve and REST recovers it; the Mind reads the body. EATING relieves hunger (bd_meal_feeds); buying does not.",
  "rules": [
    {
      "name": "bd_meal_health",
      "batch": false,
      "comment": "Body layer -- World acts on the Body: a spoiled meal (low feeling) lowers the BODY's health (scaled by how spoiled), once per meal (health_done). Health feeds strength/stamina, so it also flags stats_dirty. A physical consequence, NOT a mind decision -- the mind reads it.",
      "match": [
        [
          "agent",
          "has_body",
          "body"
        ],
        [
          "agent",
          "ate",
          "meal"
        ]
      ],
      "where": {
        "type": "And",
        "items": [
          {
            "type": "Eq",
            "a": {
              "type": "Plus",
              "items": [
                {
                  "type": "Attr",
                  "node": {
                    "type": "Var",
                    "name": "meal"
                  },
                  "key": "has_feeling"
                },
                {
                  "type": "Lit",
                  "value": 0.0
                }
              ]
            },
            "b": {
              "type": "Lit",
              "value": 1.0
            }
          },
          {
            "type": "Eq",
            "a": {
              "type": "Plus",
              "items": [
                {
                  "type": "Attr",
                  "node": {
                    "type": "Var",
                    "name": "meal"
                  },
                  "key": "health_done"
                },
                {
                  "type": "Lit",
                  "value": 0.0
                }
              ]
            },
            "b": {
              "type": "Lit",
              "value": 0.0
            }
          }
        ]
      },
      "effects": [
        [
          "set_attr",
          "body",
          "health",
          {
            "__term__": {
              "type": "Max",
              "items": [
                {
                  "type": "Lit",
                  "value": 0.0
                },
                {
                  "type": "Minus",
                  "a": {
                    "type": "Plus",
                    "items": [
                      {
                        "type": "Attr",
                        "node": {
                          "type": "Var",
                          "name": "body"
                        },
                        "key": "health"
                      },
                      {
                        "type": "Lit",
                        "value": 0.0
                      }
                    ]
                  },
                  "b": {
                    "type": "Times",
                    "items": [
                      {
                        "type": "Minus",
                        "a": {
                          "type": "Lit",
                          "value": 1.0
                        },
                        "b": {
                          "type": "Plus",
                          "items": [
                            {
                              "type": "Attr",
                              "node": {
                                "type": "Var",
                                "name": "meal"
                              },
                              "key": "feeling"
                            },
                            {
                              "type": "Lit",
                              "value": 0.0
                            }
                          ]
                        }
                      },
                      {
                        "type": "Lit",
                        "value": 0.5
                      }
                    ]
                  }
                }
              ]
            }
          }
        ],
        [
          "set_attr",
          "body",
          "stats_dirty",
          1.0
        ],
        [
          "set_attr",
          "meal",
          "health_done",
          1.0
        ]
      ]
    },
