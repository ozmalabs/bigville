    {
      "name": "bd_exert_cost",
      "batch": false,
      "comment": "Body layer -- exertion COSTS the short-term stamina RESERVE (clamped >=0) AND makes you HUNGRIER (raises hunger_level by stamina_cost*HUNGER_PER_STAMINA -- the same hunger the sustenance drive reads, so exerting yourself needs more food). Once per effort (cost_done). Reserve is current endurance (0..capacity); empty -> too tired to work.",
      "match": [
        [
          "agent",
          "has_body",
          "body"
        ],
        [
          "agent",
          "exerted",
          "effort"
        ]
      ],
      "where": {
        "type": "And",
