{
  "id": "bigville_stress",
  "version": "1.0.0",
  "depends_on": [],
  "self_load_only": true,
  "description": "bigville R37 / cognitive C4 (block 328000): ALLOSTATIC LOAD + coping (McEwen + Lazarus + window of tolerance). al_accumulate: a perceived stressor adds its magnitude to load (once) -- chronic wear-and-tear, many small = one large. al_break: load>window -> broken (breakdown), a chronic threshold not a single acute trigger. al_cope: a coping act (co-regulation) reduces load by coping_relief (floored 0). al_recover: a broken agent whose load falls back within the window recovers. al_rest: per rest epoch load *= recovery (passive recovery); recovery=0 wipes load each rest (falsifier -> chronic stress never accumulates).",
  "nodes": [],
  "edges": [],
  "productions": [],
  "concepts": [],
  "rules": [
    {
      "name": "al_accumulate",
      "batch": false,
      "comment": "A perceived stressor adds its magnitude to allostatic load (once) -- accumulation.",
      "match": [
        [
          "a",
          "perceives_stress",
          "s"
        ]
      ],
      "where": {
        "type": "Not",
        "arg": {
          "type": "Eq",
          "a": {
            "type": "Plus",
            "items": [
              {
                "type": "Attr",
                "node": {
                  "type": "Var",
                  "name": "s"
                },
                "key": "absorbed"
              },
              {
                "type": "Lit",
                "value": 0.0
              }
            ]
          },
          "b": {
            "type": "Lit",
            "value": 1.0
          }
        }
      },
      "effects": [
        [
          "set_attr",
          "a",
          "load",
          {
            "__term__": {
              "type": "Plus",
              "items": [
                {
                  "type": "Plus",
                  "items": [
                    {
                      "type": "Attr",
                      "node": {
                        "type": "Var",
                        "name": "a"
                      },
                      "key": "load"
                    },
                    {
                      "type": "Lit",
                      "value": 0.0
                    }
                  ]
                },
                {
                  "type": "Plus",
                  "items": [
                    {
                      "type": "Attr",
                      "node": {
                        "type": "Var",
                        "name": "s"
                      },
                      "key": "magnitude"
                    },
                    {
                      "type": "Lit",
                      "value": 0.0
                    }
                  ]
                }
              ]
            }
          }
        ],
        [
          "set_attr",
          "s",
          "absorbed",
          1.0
        ]
      ]
    },
    {
      "name": "al_break",
      "batch": false,
      "comment": "When cumulative load crosses the window of tolerance, the agent breaks down.",
      "match": [
        [
          "town",
          "has_agent",
          "a"
        ]
      ],
      "where": {
        "type": "And",
        "items": [
          {
            "type": "Gt",
            "a": {
              "type": "Plus",
              "items": [
                {
                  "type": "Attr",
                  "node": {
                    "type": "Var",
                    "name": "a"
                  },
                  "key": "load"
                },
                {
                  "type": "Lit",
                  "value": 0.0
                }
              ]
            },
            "b": {
              "type": "Plus",
              "items": [
                {
                  "type": "Attr",
                  "node": {
                    "type": "Var",
                    "name": "a"
                  },
                  "key": "window"
                },
                {
                  "type": "Lit",
                  "value": 0.0
                }
              ]
            }
          },
          {
            "type": "Not",
            "arg": {
              "type": "Eq",
              "a": {
                "type": "Plus",
                "items": [
                  {
                    "type": "Attr",
                    "node": {
                      "type": "Var",
                      "name": "a"
                    },
                    "key": "broken"
                  },
                  {
                    "type": "Lit",
                    "value": 0.0
                  }
                ]
              },
              "b": {
                "type": "Lit",
                "value": 1.0
              }
            }
          }
        ]
      },
      "effects": [
        [
          "set_attr",
          "a",
          "broken",
          1.0
        ]
      ]
    },
    {
      "name": "al_cope",
      "batch": false,
      "comment": "A coping act (co-regulation) reduces allostatic load (floored at 0).",
      "match": [
        [
          "town",
          "has_agent",
          "a"
        ]
      ],
      "where": {
        "type": "Eq",
        "a": {
          "type": "Plus",
          "items": [
            {
              "type": "Attr",
              "node": {
                "type": "Var",
                "name": "a"
              },
              "key": "cope_armed"
            },
            {
              "type": "Lit",
              "value": 0.0
            }
          ]
        },
        "b": {
          "type": "Lit",
          "value": 1.0
        }
      },
      "effects": [
        [
          "set_attr",
          "a",
          "load",
          {
            "__term__": {
              "type": "Max",
              "items": [
                {
                  "type": "Lit",
                  "value": 0.0
                },
                {
                  "type": "Minus",
                  "a": {
                    "type": "Plus",
                    "items": [
                      {
                        "type": "Attr",
                        "node": {
                          "type": "Var",
                          "name": "a"
                        },
                        "key": "load"
                      },
                      {
                        "type": "Lit",
                        "value": 0.0
                      }
                    ]
                  },
                  "b": {
                    "type": "Plus",
                    "items": [
                      {
                        "type": "Attr",
                        "node": {
                          "type": "Var",
                          "name": "a"
                        },
                        "key": "coping_relief"
                      },
                      {
                        "type": "Lit",
                        "value": 0.0
                      }
                    ]
                  }
                }
              ]
            }
          }
        ],
        [
          "set_attr",
          "a",
          "cope_armed",
          0.0
        ]
      ]
    },
    {
      "name": "al_recover",
      "batch": false,
      "comment": "A broken agent whose load falls back within the window recovers.",
      "match": [
        [
          "town",
          "has_agent",
          "a"
        ]
      ],
      "where": {
        "type": "And",
        "items": [
          {
            "type": "Eq",
            "a": {
              "type": "Plus",
              "items": [
                {
                  "type": "Attr",
                  "node": {
                    "type": "Var",
                    "name": "a"
                  },
                  "key": "broken"
                },
                {
                  "type": "Lit",
                  "value": 0.0
                }
              ]
            },
            "b": {
              "type": "Lit",
              "value": 1.0
            }
          },
          {
            "type": "Not",
            "arg": {
              "type": "Gt",
              "a": {
                "type": "Plus",
                "items": [
                  {
                    "type": "Attr",
                    "node": {
                      "type": "Var",
                      "name": "a"
                    },
                    "key": "load"
                  },
                  {
                    "type": "Lit",
                    "value": 0.0
                  }
                ]
              },
              "b": {
                "type": "Plus",
                "items": [
                  {
                    "type": "Attr",
                    "node": {
                      "type": "Var",
                      "name": "a"
                    },
                    "key": "window"
                  },
                  {
                    "type": "Lit",
                    "value": 0.0
                  }
                ]
              }
            }
          }
        ]
      },
      "effects": [
        [
          "set_attr",
          "a",
          "broken",
          0.0
        ]
      ]
    },
    {
      "name": "al_rest",
      "batch": false,
      "comment": "Per rest epoch, load decays geometrically (passive recovery); recovery=0 wipes it.",
      "match": [
        [
          "town",
          "has_agent",
          "a"
        ]
      ],
      "where": {
        "type": "Lt",
        "a": {
          "type": "Plus",
          "items": [
            {
              "type": "Attr",
              "node": {
                "type": "Var",
                "name": "a"
              },
              "key": "rested_epoch"
            },
            {
              "type": "Lit",
              "value": 0.0
            }
          ]
        },
        "b": {
          "type": "Plus",
          "items": [
            {
              "type": "Attr",
              "node": {
                "type": "Var",
                "name": "town"
              },
              "key": "rest_epoch"
            },
