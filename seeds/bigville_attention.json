{
  "id": "bigville_attention",
  "version": "1.0.0",
  "depends_on": [],
  "self_load_only": true,
  "description": "bigville R36 / cognitive C2 (block 327000): ATTENTION as a bounded, arousal-modulated resource (Yerkes-Dodson + working-memory capacity). at_focus: arousal = baseline_arousal + unmet_pressure; focus = max(0, 1 - overload_gain*(arousal - arousal_opt)^2) -- the INVERTED-U: focus peaks at arousal_opt and falls under BOTH under- and over-arousal; unmet drives (C1) push arousal up and cost focus. at_complete: a task completes IFF focus >= task.demand (bounded capacity -- an unfocused agent cannot do demanding work), outcome = base_skill*focus (focus multiplies competence). overload_gain=0 removes the curve (falsifier).",
  "nodes": [],
  "edges": [],
  "productions": [],
  "concepts": [],
  "rules": [
    {
      "name": "at_focus",
      "batch": false,
      "comment": "Yerkes-Dodson inverted-U: focus = max(0, 1 - overload_gain*(arousal - arousal_opt)^2).",
      "match": [
        [
          "town",
          "has_agent",
          "a"
        ]
      ],
      "where": {
        "type": "Lit",
        "value": true
      },
      "effects": [
        [
          "set_attr",
          "a",
          "arousal_eff",
          {
            "__term__": {
              "type": "Plus",
              "items": [
                {
                  "type": "Plus",
                  "items": [
                    {
                      "type": "Attr",
                      "node": {
                        "type": "Var",
                        "name": "a"
                      },
                      "key": "baseline_arousal"
                    },
                    {
                      "type": "Lit",
                      "value": 0.0
                    }
                  ]
                },
                {
                  "type": "Plus",
                  "items": [
                    {
                      "type": "Attr",
                      "node": {
                        "type": "Var",
                        "name": "a"
                      },
                      "key": "unmet_pressure"
                    },
                    {
                      "type": "Lit",
                      "value": 0.0
                    }
                  ]
                }
              ]
            }
          }
        ],
        [
          "set_attr",
          "a",
          "focus",
          {
            "__term__": {
              "type": "Max",
              "items": [
                {
                  "type": "Lit",
                  "value": 0.0
                },
                {
                  "type": "Minus",
                  "a": {
                    "type": "Lit",
                    "value": 1.0
                  },
                  "b": {
                    "type": "Times",
                    "items": [
                      {
                        "type": "Plus",
                        "items": [
                          {
                            "type": "Attr",
                            "node": {
                              "type": "Var",
                              "name": "a"
                            },
                            "key": "overload_gain"
                          },
                          {
                            "type": "Lit",
                            "value": 0.0
                          }
                        ]
                      },
                      {
                        "type": "Times",
                        "items": [
                          {
                            "type": "Minus",
                            "a": {
                              "type": "Plus",
                              "items": [
                                {
                                  "type": "Plus",
                                  "items": [
                                    {
                                      "type": "Attr",
                                      "node": {
                                        "type": "Var",
                                        "name": "a"
                                      },
                                      "key": "baseline_arousal"
                                    },
                                    {
                                      "type": "Lit",
                                      "value": 0.0
                                    }
                                  ]
                                },
                                {
                                  "type": "Plus",
                                  "items": [
                                    {
                                      "type": "Attr",
                                      "node": {
                                        "type": "Var",
                                        "name": "a"
                                      },
                                      "key": "unmet_pressure"
                                    },
                                    {
                                      "type": "Lit",
                                      "value": 0.0
                                    }
                                  ]
                                }
                              ]
                            },
                            "b": {
                              "type": "Plus",
                              "items": [
                                {
                                  "type": "Attr",
                                  "node": {
                                    "type": "Var",
                                    "name": "a"
                                  },
                                  "key": "arousal_opt"
                                },
                                {
                                  "type": "Lit",
                                  "value": 0.0
                                }
                              ]
                            }
                          },
                          {
                            "type": "Minus",
                            "a": {
                              "type": "Plus",
                              "items": [
                                {
                                  "type": "Plus",
                                  "items": [
                                    {
                                      "type": "Attr",
                                      "node": {
                                        "type": "Var",
                                        "name": "a"
                                      },
                                      "key": "baseline_arousal"
                                    },
                                    {
                                      "type": "Lit",
                                      "value": 0.0
                                    }
                                  ]
                                },
                                {
                                  "type": "Plus",
                                  "items": [
                                    {
                                      "type": "Attr",
                                      "node": {
                                        "type": "Var",
                                        "name": "a"
                                      },
                                      "key": "unmet_pressure"
                                    },
                                    {
                                      "type": "Lit",
                                      "value": 0.0
                                    }
                                  ]
                                }
                              ]
                            },
                            "b": {
                              "type": "Plus",
                              "items": [
                                {
                                  "type": "Attr",
                                  "node": {
                                    "type": "Var",
                                    "name": "a"
                                  },
                                  "key": "arousal_opt"
                                },
                                {
                                  "type": "Lit",
                                  "value": 0.0
                                }
                              ]
                            }
                          }
                        ]
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      ]
    },
    {
      "name": "at_complete",
      "batch": false,
      "comment": "A task completes iff focus >= its demand (bounded capacity); outcome = base_skill*focus.",
      "match": [
        [
          "a",
          "has_task",
          "task"
        ]
      ],
      "where": {
        "type": "And",
        "items": [
          {
            "type": "Gte",
            "a": {
              "type": "Plus",
              "items": [
                {
                  "type": "Attr",
                  "node": {
                    "type": "Var",
                    "name": "a"
                  },
                  "key": "focus"
                },
                {
                  "type": "Lit",
                  "value": 0.0
                }
              ]
            },
            "b": {
              "type": "Plus",
              "items": [
                {
                  "type": "Attr",
                  "node": {
                    "type": "Var",
                    "name": "task"
                  },
                  "key": "demand"
                },
                {
                  "type": "Lit",
                  "value": 0.0
                }
              ]
            }
          },
          {
            "type": "Not",
            "arg": {
              "type": "Eq",
              "a": {
                "type": "Plus",
                "items": [
                  {
                    "type": "Attr",
                    "node": {
                      "type": "Var",
                      "name": "task"
                    },
                    "key": "done"
                  },
                  {
                    "type": "Lit",
                    "value": 0.0
                  }
                ]
              },
              "b": {
                "type": "Lit",
                "value": 1.0
              }
            }
          }
        ]
      },
      "effects": [
        [
          "set_attr",
          "task",
          "done",
          1.0
        ],
        [
          "set_attr",
          "task",
          "outcome",
          {
            "__term__": {
              "type": "Times",
              "items": [
                {
                  "type": "Plus",
                  "items": [
                    {
                      "type": "Attr",
                      "node": {
                        "type": "Var",
                        "name": "task"
                      },
                      "key": "base_skill"
                    },
                    {
                      "type": "Lit",
                      "value": 0.0
                    }
                  ]
                },
                {
                  "type": "Plus",
                  "items": [
                    {
                      "type": "Attr",
                      "node": {
                        "type": "Var",
                        "name": "a"
                      },
                      "key": "focus"
                    },
                    {
                      "type": "Lit",
                      "value": 0.0
                    }
                  ]
                }
              ]
            }
          }
        ]
      ]
    }
  ]
}