                            "value": 0.0
                          }
                        ]
                      },
                      "b": {
                        "type": "Plus",
                        "items": [
                          {
                            "type": "Attr",
                            "node": {
                              "type": "Var",
                              "name": "tool"
                            },
                            "key": "decay"
                          },
