{
  "id": "bigville_action_decay",
  "version": "1.1.0",
  "depends_on": [],
  "self_load_only": true,
  "description": "bigville R83 (block 405000): WEAR FROM USE + DAMAGE OVER TIME, with ADJECTIVAL CLASSES. Every item has a wear_rate (per use) and a decay_rate (per period, by its adjectival class). dt_decay decays a discrete tool over time (rust); dk_decay decays a perishable stock's freshness (rot); dk_spoil discards a fully-rotted stock. The adjective describing any item (worn/rusty/ruined; fresh/stale/rotten/putrid; frayed/ragged ...) is read from its adjectival class + condition. Data-driven (ADJECTIVES + per-class decay). cd_decay/cd_spoil decay food stored in a container, slowed by the container's decay_factor (a LARDER keeps it ~3x longer).",
  "nodes": [],
  "edges": [],
  "productions": [],
  "concepts": [],
  "rules": [
    {
      "name": "dt_decay",
      "batch": false,
      "comment": "DAMAGE OVER TIME: each period a discrete tool's condition drops by its DECAY rate (rust/rot, distinct from use-wear), and its Fitness scales with the new condition. Different items decay at different rates (its adjectival class); the adjective describing it (worn/rusty/ruined ...) follows its condition.",
      "match": [
        [
          "town",
          "has_tool_item",
          "tool"
        ],
        [
          "tool",
          "fit_for",
          "fit"
        ]
      ],
      "where": {
        "type": "And",
        "items": [
          {
            "type": "Gt",
            "a": {
              "type": "Plus",
              "items": [
                {
                  "type": "Attr",
                  "node": {
                    "type": "Var",
                    "name": "tool"
                  },
                  "key": "decay"
                },
                {
                  "type": "Lit",
                  "value": 0.0
                }
              ]
            },
            "b": {
              "type": "Lit",
              "value": 0.0
            }
          },
          {
            "type": "Lt",
            "a": {
              "type": "Plus",
              "items": [
                {
                  "type": "Attr",
                  "node": {
                    "type": "Var",
                    "name": "tool"
                  },
                  "key": "decay_epoch"
                },
                {
                  "type": "Lit",
                  "value": 0.0
                }
              ]
            },
            "b": {
              "type": "Plus",
              "items": [
                {
                  "type": "Attr",
                  "node": {
                    "type": "Var",
                    "name": "town"
                  },
                  "key": "period"
                },
                {
                  "type": "Lit",
                  "value": 0.0
                }
              ]
            }
          }
        ]
      },
      "effects": [
        [
          "set_attr",
          "fit",
          "mult",
          {
            "__term__": {
              "type": "Times",
              "items": [
                {
                  "type": "Plus",
                  "items": [
                    {
                      "type": "Attr",
                      "node": {
                        "type": "Var",
                        "name": "fit"
                      },
                      "key": "base"
                    },
                    {
                      "type": "Lit",
                      "value": 0.0
                    }
                  ]
                },
                {
                  "type": "Max",
                  "items": [
                    {
                      "type": "Lit",
                      "value": 0.0
                    },
                    {
                      "type": "Minus",
                      "a": {
                        "type": "Plus",
                        "items": [
                          {
                            "type": "Attr",
                            "node": {
                              "type": "Var",
                              "name": "tool"
                            },
                            "key": "condition"
                          },
                          {
