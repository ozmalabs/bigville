              "type": "Attr",
              "node": {
                "type": "Var",
                "name": "member"
              },
              "key": "alive"
            },
            {
              "type": "Lit",
              "value": 0.0
            }
          ]
        },
        "b": {
          "type": "Lit",
          "value": 1.0
        }
      },
