{
 "id": "bigville_time_concern",
 "version": "1.0.0",
 "depends_on": [],
 "self_load_only": true,
 "description": "BIGVILLE R3 (block 251000) -- a WITNESSED collapse fires CONCERN. Reuses the 239000 affect representation (AffectiveState + the arousal/valence channel the arousal_window_coreg co-regulation rules ride): `bt_concern` matches a witness with a `witnesses` edge to a COLLAPSED victim and (a) RAISES the witness's AffectiveState.arousal by concern_mag and LOWERS valence by concern_drop (the co-regulation currency -- with arousal_window_coreg also loaded a large enough push can trip dysreg_onset_hyper, coupling self-management to the social-affect layer), and (b) mints a glass-box `Concern` node w-raised->c-about->victim. OCCLUSION-GATED: the adapter mints the `witnesses` edge ONLY when the witness PERCEIVES the collapse through the phase-driven sight range (short at night), so an occluded/unwitnessed collapse mints NO edge => bt_concern never matches => NO concern (ties to G-dark). The perception is mechanical adapter ingest; the DECISION that a witnessed collapse is concerning is THIS rule. Composes existing Terms only -- zero new Rust.",
 "nodes": [],
 "edges": [],
 "productions": [],
 "concepts": [],
 "rules": [
  {
   "name": "bt_concern",
   "match": [
    [
     "w",
     "witnesses",
     "victim"
    ],
    [
     "w",
     "has_affective_state",
     "waff"
    ]
   ],
   "where": {
    "type": "And",
    "items": [
     {
      "type": "Eq",
      "a": {
       "type": "Plus",
       "items": [
        {
         "type": "Attr",
         "node": {
          "type": "Var",
          "name": "victim"
         },
         "key": "collapsed"
        },
        {
         "type": "Lit",
         "value": 0
        }
       ]
      },
      "b": {
       "type": "Lit",
       "value": 1.0
      }
     },
     {
      "type": "Eq",
      "a": {
       "type": "Plus",
       "items": [
        {
         "type": "Attr",
         "node": {
          "type": "Var",
          "name": "waff"
         },
         "key": "concerned"
        },
        {
         "type": "Lit",
         "value": 0
        }
       ]
      },
      "b": {
       "type": "Lit",
       "value": 0.0
      }
     }
    ]
   },
   "effects": [
    [
     "set_attr",
     "waff",
     "arousal",
     {
      "__term__": {
       "type": "Plus",
       "items": [
        {
         "type": "Plus",
         "items": [
          {
           "type": "Attr",
           "node": {
            "type": "Var",
            "name": "waff"
           },
           "key": "arousal"
          },
          {
           "type": "Lit",
           "value": 0
          }
         ]
        },
        {
         "type": "Plus",
         "items": [
          {
           "type": "Attr",
           "node": {
            "type": "Var",
            "name": "waff"
           },
           "key": "concern_mag"
          },
          {
           "type": "Lit",
           "value": 0
          }
         ]
        }
       ]
      }
     }
    ],
    [
     "set_attr",
     "waff",
     "valence",
     {
      "__term__": {
       "type": "Minus",
       "a": {
        "type": "Plus",
        "items": [
         {
          "type": "Attr",
          "node": {
           "type": "Var",
           "name": "waff"
          },
          "key": "valence"
         },
         {
          "type": "Lit",
          "value": 0
         }
        ]
       },
       "b": {
        "type": "Plus",
        "items": [
         {
          "type": "Attr",
          "node": {
           "type": "Var",
           "name": "waff"
          },
          "key": "concern_drop"
         },
         {
          "type": "Lit",
          "value": 0
         }
        ]
       }
      }
     }
    ],
    [
     "set_attr",
     "waff",
     "concerned",
     1.0
    ],
    [
     "add_node",
     "c",
     "Concern",
     {
      "kind": 1.0
     }
    ],
    [
     "add_edge",
     "w",
     "raised",
     "c"
    ],
    [
     "add_edge",
