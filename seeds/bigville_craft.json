    {
      "name": "cr_assemble",
      "batch": false,
      "comment": "ASSEMBLY IS AN ACT SOMEONE PERFORMS -- it does NOT happen by itself. An assembler hafts a specific head + handle (asm -hafts-> head, asm -hafts-> handle) and is assemble_armed. Only then are the two fitted into a Tool (identity/verb/base_mult from the head; quality = the average of the parts; Fitness = base_mult*combined). The parts are consumed (assembled=1, part_of the tool) and the hafts edges + arming are cleared. A head and a handle left on the shelf stay loose until someone decides to join them.",
      "match": [
        [
          "town",
          "has_assembler",
          "asm"
        ],
        [
          "asm",
          "hafts",
          "head"
        ],
        [
          "asm",
          "hafts",
          "handle"
        ]
      ],
      "where": {
        "type": "And",
        "items": [
          {
            "type": "Eq",
            "a": {
              "type": "Plus",
              "items": [
                {
                  "type": "Attr",
                  "node": {
                    "type": "Var",
                    "name": "asm"
                  },
                  "key": "assemble_armed"
                },
                {
                  "type": "Lit",
                  "value": 0.0
                }
              ]
            },
            "b": {
              "type": "Lit",
              "value": 1.0
            }
          },
          {
            "type": "Eq",
            "a": {
