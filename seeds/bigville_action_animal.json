{
  "id": "bigville_action_animal",
  "version": "1.0.0",
  "depends_on": [],
  "self_load_only": true,
  "description": "bigville R80 (block 402000): ANIMALS EAT THEIR FEED AND STARVE WITHOUT IT. af_hunger makes a living animal hungrier each period; af_eat feeds it if its `eats` kind is in the store (consuming its ration -- a consumption loop that eats the feed down); af_starve kills an animal that has been hungry past its starve_limit. So a herd must be FED (grass/hay/grain from the farm) or it dies -- the feed is a real demand. Data-driven (eats/ration/starve_limit from ANIMALS).",
  "nodes": [],
  "edges": [],
  "productions": [],
  "concepts": [],
  "rules": [
    {
      "name": "af_hunger",
      "batch": false,
      "comment": "Each period (epoch guard hunger_epoch < town.period), a living animal gets hungrier (hunger += 1).",
      "match": [
        [
          "town",
          "has_animal",
          "an"
        ]
      ],
      "where": {
        "type": "And",
        "items": [
          {
            "type": "Eq",
            "a": {
              "type": "Plus",
              "items": [
                {
                  "type": "Attr",
                  "node": {
                    "type": "Var",
                    "name": "an"
                  },
                  "key": "alive"
                },
                {
                  "type": "Lit",
                  "value": 0.0
                }
              ]
            },
            "b": {
              "type": "Lit",
              "value": 1.0
            }
          },
          {
            "type": "Lt",
            "a": {
              "type": "Plus",
              "items": [
                {
                  "type": "Attr",
                  "node": {
                    "type": "Var",
                    "name": "an"
                  },
                  "key": "hunger_epoch"
                },
                {
                  "type": "Lit",
                  "value": 0.0
                }
              ]
            },
            "b": {
              "type": "Plus",
              "items": [
                {
                  "type": "Attr",
                  "node": {
                    "type": "Var",
                    "name": "town"
                  },
                  "key": "period"
                },
                {
                  "type": "Lit",
                  "value": 0.0
                }
              ]
            }
          }
        ]
      },
      "effects": [
        [
          "set_attr",
          "an",
          "hunger",
          {
            "__term__": {
              "type": "Plus",
              "items": [
                {
                  "type": "Plus",
                  "items": [
                    {
                      "type": "Attr",
                      "node": {
                        "type": "Var",
                        "name": "an"
                      },
                      "key": "hunger"
                    },
                    {
                      "type": "Lit",
                      "value": 0.0
                    }
                  ]
                },
                {
                  "type": "Lit",
                  "value": 1.0
                }
              ]
            }
          }
        ],
        [
          "set_attr",
          "an",
          "hunger_epoch",
          {
            "__term__": {
              "type": "Plus",
              "items": [
                {
                  "type": "Attr",
                  "node": {
                    "type": "Var",
                    "name": "town"
                  },
                  "key": "period"
                },
                {
                  "type": "Lit",
                  "value": 0.0
                }
              ]
            }
          }
        ]
      ]
    },
    {
      "name": "af_eat",
      "batch": false,
      "comment": "A hungry living animal EATS ITS FEED if it is in the store: it consumes its ration of the kind it `eats` (store[eats] -= ration) and its hunger resets to 0. A consumption loop -- the herd eats down the feed each period; if the feed runs out the animal cannot eat and starves.",
      "match": [
        [
          "town",
          "has_animal",
          "an"
        ],
        [
          "town",
          "has_store",
          "store"
        ],
        [
          "store",
          "stock",
          "s"
        ]
      ],
      "where": {
        "type": "And",
        "items": [
          {
            "type": "Eq",
            "a": {
              "type": "Plus",
              "items": [
                {
                  "type": "Attr",
                  "node": {
                    "type": "Var",
                    "name": "an"
                  },
                  "key": "alive"
                },
                {
                  "type": "Lit",
                  "value": 0.0
                }
              ]
            },
            "b": {
              "type": "Lit",
              "value": 1.0
            }
          },
          {
            "type": "Gt",
            "a": {
              "type": "Plus",
              "items": [
                {
                  "type": "Attr",
                  "node": {
                    "type": "Var",
                    "name": "an"
                  },
                  "key": "hunger"
                },
                {
                  "type": "Lit",
                  "value": 0.0
                }
              ]
            },
            "b": {
              "type": "Lit",
              "value": 0.0
            }
          },
          {
            "type": "Eq",
            "a": {
              "type": "Attr",
              "node": {
                "type": "Var",
                "name": "s"
              },
              "key": "kind"
            },
            "b": {
              "type": "Attr",
              "node": {
                "type": "Var",
                "name": "an"
              },
              "key": "eats"
            }
          },
          {
            "type": "Gte",
            "a": {
              "type": "Plus",
              "items": [
                {
                  "type": "Attr",
                  "node": {
                    "type": "Var",
                    "name": "s"
                  },
                  "key": "qty"
                },
                {
                  "type": "Lit",
                  "value": 0.0
                }
              ]
            },
            "b": {
              "type": "Plus",
              "items": [
                {
                  "type": "Attr",
                  "node": {
                    "type": "Var",
                    "name": "an"
                  },
                  "key": "ration"
                },
                {
                  "type": "Lit",
                  "value": 0.0
                }
              ]
            }
          }
        ]
      },
      "effects": [
        [
          "set_attr",
          "s",
          "qty",
          {
            "__term__": {
              "type": "Minus",
              "a": {
                "type": "Plus",
                "items": [
                  {
                    "type": "Attr",
                    "node": {
                      "type": "Var",
                      "name": "s"
                    },
                    "key": "qty"
                  },
                  {
                    "type": "Lit",
                    "value": 0.0
                  }
                ]
              },
              "b": {
                "type": "Plus",
                "items": [
                  {
                    "type": "Attr",
                    "node": {
                      "type": "Var",
                      "name": "an"
                    },
                    "key": "ration"
                  },
                  {
                    "type": "Lit",
                    "value": 0.0
                  }
                ]
