{
 "id": "bigville_actor_decision",
 "version": "1.1.0",
 "depends_on": [],
 "self_load_only": true,
 "description": "Graph-native resident action selection. The world publishes currently legal ActorOption affordances; the resident's Ocelot graph selects the best option and exposes its action payload. Selection is the affordance's own score less the EFFORT the route costs THIS resident: the world's per-terrain `stamina_multiplier` (path 0.65 < grass 1.00 < tree 2.00 < water 4.00) scaled by how depleted the resident currently is (1 - stamina_reserve). A rested resident is unaffected -- the penalty is zero at full reserve, so terrain costs nothing you care about when fresh and dominates when you are spent. That is what makes two residents on the same map take different routes. The adapter only reads and enacts the choice.",
 "nodes": [],
 "edges": [],
 "productions": [],
 "concepts": [],
 "rules": [
  {
   "name": "oa_choose_option",
   "batch": false,
   "comment": "Select one currently afforded action by graph-native Argmax.",
   "match": [
    [
     "a",
     "has_option",
     "option"
    ]
   ],
   "where": {
    "type": "And",
    "items": [
     {
      "type": "Eq",
      "a": {
       "type": "Attr",
       "node": {
        "type": "Var",
        "name": "a"
       },
       "key": "decision_armed"
      },
      "b": {
       "type": "Lit",
       "value": 1.0
      }
     },
     {
      "type": "Eq",
      "a": {
       "type": "Attr",
       "node": {
        "type": "Var",
        "name": "a"
       },
       "key": "chosen_action"
      },
      "b": {
       "type": "Lit",
       "value": ""
      }
     }
    ]
   },
   "effects": [
    [
     "set_attr",
     "a",
     "chosen_action",
     {
      "__term__": {
       "type": "Attr",
       "node": {
        "type": "Argmax",
        "source": {
         "type": "Neighbours",
         "node": {
          "type": "Var",
          "name": "a"
         },
         "edge_type": "has_option",
         "any_type": false
        },
        "var_name": "candidate",
        "value": {
         "type": "Plus",
         "items": [
          {
           "type": "Attr",
           "node": {
            "type": "Var",
            "name": "candidate"
           },
           "key": "score"
          },
          {
           "type": "Times",
           "items": [
            {
             "type": "Lit",
             "value": -6.0
            },
            {
             "type": "Plus",
             "items": [
              {
               "type": "Attr",
               "node": {
                "type": "Var",
                "name": "candidate"
               },
               "key": "terrain_stamina_multiplier"
              },
              {
               "type": "Lit",
               "value": 0.0
              }
             ]
            },
            {
             "type": "Minus",
             "a": {
              "type": "Lit",
              "value": 1.0
             },
             "b": {
              "type": "Plus",
              "items": [
               {
                "type": "Attr",
                "node": {
                 "type": "Var",
                 "name": "a"
                },
                "key": "stamina_reserve"
               },
               {
                "type": "Lit",
                "value": 0.0
               }
              ]
             }
            }
           ]
          }
         ]
        },
        "default": {
         "type": "Lit",
         "value": "rest"
        }
       },
       "key": "action"
      }
     }
    ],
    [
     "set_attr",
     "a",
